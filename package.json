{
  "name": "doc-ai-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "electron:compile": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "electron:dev": "npm run electron:compile && cross-env NODE_ENV=development electron dist-electron/main.js",
    "dev:all": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "dist": "npm run build && npm run electron:compile && electron-builder"
  },
  "build": {
    "appId": "com.dashmake.docaiassistant",
    "productName": "Doc AI Assistant",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.2",
    "unocss": "^66.7.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "deep-chat": "^2.4.2",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "groq-sdk": "^1.3.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.3.1"
  }
}